#!/bin/sh
# Runs tools/agentville.mjs from anywhere (follows symlinks, so it can be linked onto PATH).
src="$0"
while [ -L "$src" ]; do
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
exec node "$(cd "$(dirname "$src")" && pwd)/agentville.mjs" "$@"
