{
  "name": "agentville",
  "version": "0.1.0",
  "description": "A local pixel-art village of your Claude Code and Codex agent sessions.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/qin2500/agentville#readme",
  "repository": { "type": "git", "url": "git+https://github.com/qin2500/agentville.git" },
  "bugs": { "url": "https://github.com/qin2500/agentville/issues" },
  "engines": { "node": ">=22.13" },
  "bin": { "agentville": "server/cli.mjs" },
  "imports": { "#agentville/mod": "./web/src/engine/mod/public.js" },
  "files": ["server", "web/dist", "LICENSE", "NOTICE", "README.md"],
  "scripts": {
    "setup": "bash ./setup.sh",
    "start": "node server/cli.mjs",
    "prebuild": "node tools/mods-index.mjs",
    "build": "vite build web",
    "predev:web": "node tools/mods-index.mjs",
    "dev:web": "vite web",
    "fixtures": "node test/fixtures/make-home.mjs",
    "mods": "node tools/mods-index.mjs",
    "lint:mods": "node tools/mod-lint.mjs",
    "mod": "node tools/mod.mjs",
    "pretest": "node tools/mods-index.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build",
    "test:e2e": "playwright test",
    "app": "electron desktop",
    "app:build": "node desktop/build.mjs",
    "icon": "node tools/icon/build.mjs",
    "test:app": "playwright test -c playwright.app.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  }
}
